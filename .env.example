# Copy to .env and fill in only what you use. Never commit .env.

# --- Generation / judging (only needed with RAG_LLM=anthropic) ---
# The anthropic SDK reads ANTHROPIC_API_KEY directly.
ANTHROPIC_API_KEY=
RAG_LLM=fake
RAG_GENERATION_MODEL=claude-sonnet-5-5
RAG_JUDGE_MODEL=claude-sonnet-5-5
RAG_GENERATION_EFFORT=medium
RAG_JUDGE_EFFORT=low

# --- Embeddings: hashing (offline, default) | openai | voyage ---
RAG_EMBEDDER=hashing
RAG_EMBEDDING_DIM=512
RAG_OPENAI_API_KEY=
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_VOYAGE_API_KEY=
RAG_VOYAGE_EMBEDDING_MODEL=voyage-3.5

# --- Store: memory (default) | pgvector ---
RAG_STORE=memory
RAG_PG_DSN=postgresql://rag:rag@localhost:5433/rag
RAG_PG_TABLE=rag_chunks

# --- Chunking / retrieval ---
RAG_CHUNKER=recursive
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_CANDIDATE_K=20
